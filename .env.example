SEMANTIC_SCHOLAR_API_KEY=
REQUEST_TIMEOUT_SECONDS=20
MAX_RESULTS_PER_PROVIDER=100
MAX_RESULTS_PER_QUERY=250
MAX_TOTAL_RESULTS_PER_RUN=5000
ACADEMIC_PAGE_SIZE=100
ACADEMIC_MAX_RETRIES=3
